{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jat-author-social-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://justathoughtblog.org",
    "OPENAI_MODEL": "gpt-5-mini"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "CAPTION_RATE_LIMITER",
      "namespace_id": "57001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
