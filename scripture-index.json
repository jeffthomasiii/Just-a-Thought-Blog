---
layout: null
permalink: /assets/data/scripture-index.json
---
[
{% assign scripture_posts = site.posts | where_exp: "post", "post.scripture" %}
{% for post in scripture_posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "scripture": {{ post.scripture | jsonify }},
    "categories": {{ post.categories | default: empty | jsonify }},
    "tags": {{ post.tags | default: empty | jsonify }},
    "collections": {{ post.collections | default: empty | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
